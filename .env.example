# Maqaaxi Pos — ONE env file for the whole repo. Copy to `.env` (never commit it).
# Local dev and the production server use the same shape.
#
# Who reads it:
#   API        npm run dev (tsx --env-file ../../.env), Prisma CLI, seed
#   Docker     docker compose reads it for ${…} and gives it to the api container
#   Web        ONLY API_ORIGIN (scripts/dev-all.mjs; Docker bakes http://api:4000).
#              The web app never sees a secret.
# Docker reads this file literally: no `export`, no ${VAR} expansion inside values.

# ── API ─────────────────────────────────────────────────────────────
PORT=4100
NODE_ENV=development
# The restaurant's timezone (IANA). Receipt numbers reset at local midnight here,
# and every report's "day" is a day in this zone.
BUSINESS_TZ=Africa/Mogadishu

# Host-side URL for npm run dev / prisma / scripts (Docker Postgres on :5433).
# The api CONTAINER ignores this and uses postgres:5432 (see docker-compose.yml).
DATABASE_URL=postgresql://maqaaxi:CHANGE_ME@localhost:5433/maqaaxi
# One-off: scripts/copy-neon-to-docker.sh reads the old Neon DB from here. Delete after.
# NEON_DATABASE_URL=postgresql://…neon.tech/neondb?sslmode=require

# Signs the admin + customer session cookies. openssl rand -base64 48
# Changing it signs everybody out.
JWT_SECRET=CHANGE_ME

# Public origin customers browse on — Sifalo returns them to <this>/api/payment/return.
# Production: https://menu.kfggalkacyo.com
PUBLIC_APP_URL=http://localhost:3100

# Sifalo has no webhook; the reconciler asks about initiated checkouts so a paid
# order never sits unattended. `on` in production, `off` locally (live account).
PAYMENT_RECONCILER=off
# Proxy hops in front of the API (1 = host nginx). Production only.
# TRUST_PROXY=1

# Sifalo Pay (hosted checkout) — live gateway only.
SIFALO_API_USER=CHANGE_ME
SIFALO_API_KEY=CHANGE_ME

# Menu image uploads — AWS S3. The bucket policy must allow public s3:GetObject
# (the menu loads images straight from S3). S3_PUBLIC_URL optional (CDN domain).
AWS_ACCESS_KEY_ID=CHANGE_ME
AWS_SECRET_ACCESS_KEY=CHANGE_ME
AWS_REGION=ap-south-1
S3_BUCKET_NAME=CHANGE_ME
# S3_PUBLIC_URL=https://cdn.example.com
# Nightly database backups are also copied to S3 (private, encrypted) under
# backups/ — by default in the same bucket; set this to use a separate one.
# BACKUP_S3_BUCKET=maqaaxi-backups

# Password-reset email — Gmail address + app password
EMAIL_USER=CHANGE_ME
EMAIL_APP_PASSWORD=CHANGE_ME

# Seed accounts (npm run db:seed — NEVER against the live DB)
ADMIN_EMAIL=
ADMIN_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=
CASHIER_EMAIL=
CASHIER_PASSWORD=
WAITER_EMAIL=
WAITER_PASSWORD=

# ── Web ─────────────────────────────────────────────────────────────
# Where `next dev` proxies /api/*. (Docker images bake http://api:4000.)
API_ORIGIN=http://localhost:4100

# ── Docker (docker-compose.yml) ─────────────────────────────────────
# openssl rand -base64 24 — must match the password in DATABASE_URL.
POSTGRES_PASSWORD=CHANGE_ME
# Host ports for the api / web containers (bound to 127.0.0.1).
# Production (nginx upstreams): 4000 / 3100. Local: anything free, e.g. 4300 / 3300.
API_HOST_PORT=4000
WEB_HOST_PORT=3100
# Production pins/rolls back images here (default :latest from GHCR).
# API_IMAGE=ghcr.io/ismalure12/maqaaxi-api:sha-abc1234
# WEB_IMAGE=ghcr.io/ismalure12/maqaaxi-web:sha-abc1234

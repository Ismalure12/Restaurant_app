# Copy to deploy/api.env on the server and fill in. NOT committed (.gitignore).
# Docker reads this file literally: no quotes, no export, no ${VAR} expansion.

NODE_ENV=production
PORT=4000

# The postgres service on the compose network — NOT localhost:5433, which is
# only the host-side mapping used by psql and scripts/backup-db.sh.
DATABASE_URL=postgresql://maqaaxi:CHANGE_ME@postgres:5432/maqaaxi

# openssl rand -base64 48
JWT_SECRET=CHANGE_ME

# Public origin, used for Sifalo return URLs. Must match the real domain.
PUBLIC_APP_URL=https://menu.kfggalkacyo.com
BUSINESS_TZ=Africa/Mogadishu

# One proxy hop (host nginx) — so X-Forwarded-For is the real client IP and the
# payment rate limits cannot be faked. Set 0 only if the API is ever exposed direct.
TRUST_PROXY=1

# Sifalo has no webhook; this reconciler asks about initiated checkouts so a
# paid order never sits unattended. On in production.
PAYMENT_RECONCILER=on

SIFALO_API_USER=CHANGE_ME
SIFALO_API_KEY=CHANGE_ME

BLOB_READ_WRITE_TOKEN=CHANGE_ME
EMAIL_USER=CHANGE_ME
EMAIL_APP_PASSWORD=CHANGE_ME

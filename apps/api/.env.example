# apps/api — copy to .env. The API owns every secret; the web app has none.
PORT=4100
NODE_ENV=development

# Database — the POOLED Neon connection string
DATABASE_URL=

# Signs the admin + customer session cookies (long random string).
# Changing it signs everybody out.
JWT_SECRET=

# Image uploads (Vercel Blob)
BLOB_READ_WRITE_TOKEN=

# Password-reset email — Gmail address + app password
EMAIL_USER=
EMAIL_APP_PASSWORD=

# Sifalo Pay (hosted checkout) — live gateway only (pay.sifalo.com/business).
# The temporary test charge (FIXED_CHARGE_USD) lives in src/lib/sifalo.ts.
SIFALO_API_USER=
SIFALO_API_KEY=

# Public origin customers browse on — Sifalo returns them to <this>/api/payment/return
PUBLIC_APP_URL=http://localhost:3100

# The restaurant's timezone (IANA name). Receipt numbers reset at local
# midnight here, and every report's "day" is a day in this zone.
BUSINESS_TZ=Africa/Mogadishu

# Seed accounts, used by `npm run db:seed`
ADMIN_EMAIL=
ADMIN_PASSWORD=
MANAGER_EMAIL=
MANAGER_PASSWORD=
CASHIER_EMAIL=
CASHIER_PASSWORD=
WAITER_EMAIL=
WAITER_PASSWORD=

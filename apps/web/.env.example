# apps/web — copy to .env. No secrets belong here: the web app never touches
# the database and never signs or verifies tokens.

# Where the Express API is. Next proxies every /api/* request to it, so the
# browser stays same-origin and the login cookie works. In production nginx
# routes /api to the API directly; this is still required for the build.
API_ORIGIN=http://localhost:4100
